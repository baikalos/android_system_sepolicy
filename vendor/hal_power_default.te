type hal_power_default, domain, mlstrustedsubject;
hal_server_domain(hal_power_default, hal_power)

type hal_power_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_power_default)

allow hal_power_default vendor_data_file:dir rw_dir_perms;
allow hal_power_default vendor_data_file:file rw_file_perms;

allow hal_power_default sysfs:file rw_file_perms;
allow hal_power_default proc:file rw_file_perms;

binder_call(system_app, hal_power_default)

allow hal_power_default appdomain:process { getsched setsched };
allow hal_power_default audioserver:process { getsched setsched };
allow hal_power_default hal_audio:process { getsched setsched };
allow hal_power_default hal_bluetooth:process { getsched setsched };
allow hal_power_default hal_codec2_server:process { getsched setsched };
allow hal_power_default hal_omx_server:process { getsched setsched };
allow hal_power_default mediaswcodec:process { getsched setsched };
allow hal_power_default cameraserver:process { getsched setsched };
allow hal_power_default hal_camera:process { getsched setsched };
allow hal_power_default mediaserver:process { getsched setsched };
allow hal_power_default bootanim:process { getsched setsched };
allow hal_power_default kernel:process { getsched setsched };
allow hal_power_default platform_app:process { getsched setsched };
